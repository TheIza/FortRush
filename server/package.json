{
  "name": "fortrush-profile-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test test/nickname-policy.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-fortrush --only firestore \"npm run test:rules:node\"",
    "test:rules:node": "node --test test/firestore-rules.test.mjs",
    "test:integration": "firebase emulators:exec --project demo-fortrush-nicknames --only firestore \"node --test test/api-firestore.integration.test.mjs\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0"
  }
}
